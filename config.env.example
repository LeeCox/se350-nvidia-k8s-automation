# Copy to config.env and adjust before running any script.
# config.env is gitignored - it may end up holding a Hugging Face token.

# --- Cluster ---
export CLUSTER_NAME="se350-lab"
export KUBECONFIG_PATH="${HOME}/.kube/config"
# Keep kubectl/helm pointed at the same file, otherwise K3s's kubectl shim falls back to the
# root-only /etc/rancher/k3s/k3s.yaml.
export KUBECONFIG="${KUBECONFIG_PATH}"

# --- NVIDIA GPU Operator ---
export GPU_OPERATOR_NAMESPACE="gpu-operator"
export GPU_OPERATOR_VERSION=""   # empty = latest chart version
# auto = use the containerized driver only when the host has no working one.
# Force with "true"/"false" if you need to override the detection.
export GPU_OPERATOR_DRIVER_ENABLED="auto"

# --- KAITO (bring-your-own GPU node mode) ---
export KAITO_NAMESPACE="kaito-workspace"
export KAITO_NODE_LABEL_KEY="apps"
export KAITO_NODE_LABEL_VALUE="llm-inference"

# --- KAITO model deployment (scripts/deploy-kaito-model.sh, manual/deliberate - see FAQ.md) ---
export KAITO_WORKSPACE_NAME="workspace-nemotron-3-nano-4b"
# Curated KAITO preset name = the full Hugging Face model ID. Nemotron 3.5 Lightning (30B-A3B)
# does not fit the A2 (needs an A100/H100-class GPU) - Nano 4B is the agentic-capable model that does.
export KAITO_MODEL_PRESET="nvidia/NVIDIA-Nemotron-3-Nano-4B-BF16"

# --- NVIDIA Dynamo (single-GPU evaluation deployment) ---
export DYNAMO_NAMESPACE="dynamo"
export DYNAMO_IMAGE="nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.3.0"
export DYNAMO_MODEL_ID="Qwen/Qwen3-0.6B"

# --- Hugging Face model deployment (TGI) ---
export HF_NAMESPACE="dynamo"
export HF_MODEL_ID="microsoft/Phi-3-mini-4k-instruct"
export HF_TOKEN=""   # required only for gated models
export TGI_IMAGE="ghcr.io/huggingface/text-generation-inference:latest"

# --- Model weight cache ---
# Both workloads mount a local-path PVC for the Hugging Face cache so weights survive a pod
# restart. local-path is a bind mount on the node, so this size is advisory, not a quota -
# the real limit is free space on the root filesystem.
export MODEL_CACHE_SIZE="100Gi"

# --- Remote management ---
export ENABLE_TAILSCALE="true"
export ENABLE_COCKPIT="true"

# --- Driver install behavior ---
export AUTO_REBOOT="false"  # set true to let 01-install-nvidia-driver.sh reboot automatically
